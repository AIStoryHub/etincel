{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.etincel/etincel-nonfiction",
  "description": "Trainable non-fiction writing voice, presets, and an anti-AI-tells audit for Claude, via MCP.",
  "repository": {
    "url": "https://github.com/AIStoryHub/etincel",
    "source": "github"
  },
  "version": "0.9.2",
  "websiteUrl": "https://etincel.ai/connect",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "etincel",
      "version": "0.9.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://etincel.ai/api/mcp"
    }
  ]
}
