{
  "name": "etincel",
  "version": "0.9.2",
  "description": "Étincel: a non-fiction writing connector for Claude Code, Claude Desktop, and MCP-enabled tools. Trainable voice, premade emotional tones, and a transparent anti-AI-tells audit. Not an email client or editor replacement, a layer that keeps the writer in trust mode.",
  "mcpName": "ai.etincel/etincel-nonfiction",
  "type": "module",
  "bin": {
    "etincel": "dist/cli.js"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./tools/*": "./dist/tools/*.js",
    "./engine/*": "./dist/engine/*.js",
    "./data/*": "./dist/data/*"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/data && cp src/data/*.json dist/data/ && chmod +x dist/cli.js dist/server.js",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "smoke": "node dist/smoke.js",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "postinstall": "node -e \"require('fs').existsSync('tsconfig.json')&&require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "JP LeBlanc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIStoryHub/etincel.git"
  },
  "homepage": "https://github.com/AIStoryHub/etincel#readme",
  "bugs": "https://github.com/AIStoryHub/etincel/issues",
  "keywords": [
    "writing",
    "non-fiction",
    "prose",
    "voice",
    "style",
    "editing",
    "mcp",
    "anti-ai-slop"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
